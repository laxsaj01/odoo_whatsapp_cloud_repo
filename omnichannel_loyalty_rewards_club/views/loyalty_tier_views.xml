<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_tier_tree" model="ir.ui.view">
        <field name="name">loyalty.tier.tree</field>
        <field name="model">loyalty.tier</field>
        <field name="arch" type="xml">
            <tree string="VIP Loyalty Tiers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_spend_amount"/>
                <field name="points_multiplier"/>
                <field name="partner_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_loyalty_tier_form" model="ir.ui.view">
        <field name="name">loyalty.tier.form</field>
        <field name="model">loyalty.tier</field>
        <field name="arch" type="xml">
            <form string="VIP Loyalty Tier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Members"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Gold Elite"/></h1>
                    </div>

                    <group>
                        <group string="Progression Rules">
                            <field name="min_spend_amount"/>
                            <field name="points_multiplier"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Scope &amp; Display">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Benefits Description" name="benefits_page">
                            <field name="description" placeholder="Summary of benefits and privileges for members in this tier..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_loyalty_tier" model="ir.actions.act_window">
        <field name="name">VIP Club Tiers</field>
        <field name="res_model">loyalty.tier</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your membership tiers (Bronze, Silver, Gold, Platinum) with custom multipliers!
            </p>
        </field>
    </record>
</odoo>
