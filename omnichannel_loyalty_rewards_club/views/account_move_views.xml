<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_loyalty" model="ir.ui.view">
        <field name="name">account.move.form.inherit.loyalty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_loyalty_redeem_wizard" string="Redeem Points" type="object" class="btn-success" icon="fa-gift" 
                        invisible="move_type != 'out_invoice' or state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="customer_points_balance" string="Available Points" invisible="move_type != 'out_invoice'"/>
                <field name="loyalty_points_earned" invisible="move_type != 'out_invoice' or state != 'posted'"/>
                <field name="loyalty_points_redeemed" invisible="loyalty_points_redeemed == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
