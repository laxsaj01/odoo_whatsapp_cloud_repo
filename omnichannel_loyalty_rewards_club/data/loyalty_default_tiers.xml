<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Bronze Tier -->
        <record id="loyalty_tier_bronze" model="loyalty.tier">
            <field name="name">Bronze Club</field>
            <field name="sequence">10</field>
            <field name="min_spend_amount">0.0</field>
            <field name="points_multiplier">1.0</field>
            <field name="color">3</field>
            <field name="description">Standard introductory tier for all registered shoppers. Earns 1.0x baseline reward points.</field>
        </record>

        <!-- Silver Tier -->
        <record id="loyalty_tier_silver" model="loyalty.tier">
            <field name="name">Silver VIP</field>
            <field name="sequence">20</field>
