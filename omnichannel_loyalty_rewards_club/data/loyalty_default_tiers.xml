        </record>

        <!-- Platinum Tier -->
        <record id="loyalty_tier_platinum" model="loyalty.tier">
            <field name="name">Platinum Executive</field>
            <field name="sequence">40</field>
            <field name="min_spend_amount">5000.0</field>
            <field name="points_multiplier">2.0</field>
            <field name="color">1</field>
            <field name="description">Highest tier unlocked at $5,000 lifetime spend. Earns DOUBLE (2.0x) points on all transactions.</field>
        </record>
    </data>
