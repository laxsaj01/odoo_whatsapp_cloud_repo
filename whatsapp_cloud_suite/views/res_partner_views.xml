<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_chats" type="object" class="oe_stat_button" icon="fa-whatsapp">
                    <field name="whatsapp_chat_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">
                <button name="action_open_whatsapp_composer" string="Chat on WhatsApp" type="object" class="btn-link" icon="fa-whatsapp" invisible="not mobile and not phone"/>
            </xpath>
        </field>
    </record>
</odoo>
