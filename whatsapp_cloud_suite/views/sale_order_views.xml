<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" string="WhatsApp" type="object" class="btn-success" icon="fa-whatsapp"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="whatsapp_status" widget="badge" 
                       decoration-success="whatsapp_status == 'sent'" 
                       decoration-danger="whatsapp_status == 'failed'" 
                       decoration-muted="whatsapp_status == 'not_sent'"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="whatsapp_status" widget="badge" optional="show"
                       decoration-success="whatsapp_status == 'sent'" 
                       decoration-danger="whatsapp_status == 'failed'"/>
            </xpath>
        </field>
    </record>
</odoo>
