<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp_delivery" string="WhatsApp Tracking" type="object" class="btn-success" icon="fa-whatsapp" invisible="state != 'done' or picking_type_code != 'outgoing'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="whatsapp_delivery_status" widget="badge" 
                       invisible="picking_type_code != 'outgoing'"
                       decoration-success="whatsapp_delivery_status == 'sent'" 
                       decoration-danger="whatsapp_delivery_status == 'failed'" 
                       decoration-muted="whatsapp_delivery_status == 'not_sent'"/>
            </xpath>
        </field>
    </record>
</odoo>
