<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Message Queue Sequence -->
        <record id="seq_whatsapp_message_queue" model="ir.sequence">
            <field name="name">WhatsApp Message Queue Sequence</field>
            <field name="code">whatsapp.message.queue</field>
            <field name="prefix">WA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron: Process Outbound Queue -->
        <record id="ir_cron_whatsapp_queue_dispatcher" model="ir.cron">
            <field name="name">WhatsApp Cloud Suite: Message Queue Dispatcher</field>
            <field name="model_id" ref="model_whatsapp_message_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue(batch_size=50)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
