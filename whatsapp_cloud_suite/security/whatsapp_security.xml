<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_whatsapp_suite" model="ir.module.category">
            <field name="name">WhatsApp Cloud Suite</field>
            <field name="description">Manage user roles and permissions for WhatsApp Cloud API Suite</field>
            <field name="sequence">25</field>
        </record>

        <!-- User / Agent Group -->
        <record id="group_whatsapp_user" model="res.groups">
            <field name="name">User / Agent</field>
            <field name="category_id" ref="module_category_whatsapp_suite"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Agents can send messages, view chat history, and operate the WhatsApp composer.</field>
        </record>

        <!-- Manager / Administrator Group -->
        <record id="group_whatsapp_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_whatsapp_suite"/>
            <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Administrators can configure Meta accounts, sync templates, access system settings, and manage message queues.</field>
        </record>
    </data>

    <!-- Multi-Company Record Rules -->
    <data noupdate="1">
        <record id="whatsapp_account_company_rule" model="ir.rule">
            <field name="name">WhatsApp Account Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_account"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="whatsapp_template_company_rule" model="ir.rule">
            <field name="name">WhatsApp Template Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="whatsapp_message_queue_company_rule" model="ir.rule">
            <field name="name">WhatsApp Message Queue Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_message_queue"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="whatsapp_chat_history_company_rule" model="ir.rule">
            <field name="name">WhatsApp Chat History Multi-Company</field>
            <field name="model_id" ref="model_whatsapp_chat_history"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
