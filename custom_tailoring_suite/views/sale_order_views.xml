<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_tailoring" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tailoring</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tailoring_orders" type="object" class="oe_stat_button" icon="fa-scissors" attrs="{'invisible': [('tailoring_order_count', '=', 0)]}">
                    <field name="tailoring_order_count" widget="statinfo" string="Tailoring Jobs"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="is_bespoke_item" optional="show"/>
                <field name="tailoring_order_id" optional="show" widget="many2one"/>
            </xpath>
        </field>
    </record>

</odoo>
