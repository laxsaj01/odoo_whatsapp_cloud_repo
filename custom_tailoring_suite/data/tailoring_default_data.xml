<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Measurement Parameters -->
    <record id="param_chest" model="tailoring.measurement.parameter">
        <field name="name">Full Chest Circumference</field>
        <field name="code">CHEST</field>
        <field name="sequence">10</field>
        <field name="body_part">upper_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">25.0</field>
        <field name="max_allowed_value">65.0</field>
        <field name="help_instruction">Measure around the fullest part of the chest, keeping tape level under armpits.</field>
    </record>

    <record id="param_neck" model="tailoring.measurement.parameter">
        <field name="name">Neck Circumference</field>
        <field name="code">NECK</field>
        <field name="sequence">20</field>
        <field name="body_part">upper_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">12.0</field>
        <field name="max_allowed_value">26.0</field>
        <field name="help_instruction">Measure around the base of the neck where the collar sits comfortably.</field>
    </record>

    <record id="param_shoulder" model="tailoring.measurement.parameter">
        <field name="name">Shoulder Width (Across Back)</field>
        <field name="code">SHLDR</field>
        <field name="sequence">30</field>
        <field name="body_part">upper_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">12.0</field>
        <field name="max_allowed_value">28.0</field>
        <field name="help_instruction">Measure across the upper back from the tip of the left shoulder bone to right shoulder bone.</field>
    </record>

    <record id="param_sleeve" model="tailoring.measurement.parameter">
        <field name="name">Sleeve Length</field>
        <field name="code">SLEEVE</field>
        <field name="sequence">40</field>
        <field name="body_part">arm</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">20.0</field>
        <field name="max_allowed_value">42.0</field>
        <field name="help_instruction">From shoulder seam down to wrist bone with arm slightly bent.</field>
    </record>

    <record id="param_bicep" model="tailoring.measurement.parameter">
        <field name="name">Bicep Circumference</field>
        <field name="code">BICEP</field>
        <field name="sequence">50</field>
        <field name="body_part">arm</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">9.0</field>
        <field name="max_allowed_value">26.0</field>
        <field name="help_instruction">Measure around the widest point of the bicep muscle at rest.</field>
    </record>

    <record id="param_wrist" model="tailoring.measurement.parameter">
        <field name="name">Wrist Circumference</field>
        <field name="code">WRIST</field>
        <field name="sequence">60</field>
        <field name="body_part">arm</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">5.0</field>
        <field name="max_allowed_value">12.0</field>
        <field name="help_instruction">Measure around the wrist bone where the shirt or jacket cuff rests.</field>
    </record>

    <record id="param_jacket_length" model="tailoring.measurement.parameter">
        <field name="name">Jacket Back Length</field>
        <field name="code">JKT_LEN</field>
        <field name="sequence">70</field>
        <field name="body_part">torso</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">24.0</field>
        <field name="max_allowed_value">40.0</field>
        <field name="help_instruction">From base of collar down center back seam to desired jacket bottom hem.</field>
    </record>

    <record id="param_waist_jacket" model="tailoring.measurement.parameter">
        <field name="name">Natural Waist / Midsection</field>
        <field name="code">WAIST_NAT</field>
        <field name="sequence">80</field>
        <field name="body_part">torso</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">24.0</field>
        <field name="max_allowed_value">65.0</field>
        <field name="help_instruction">Measure around natural waistline (navel level) where coat button fastens.</field>
    </record>

    <record id="param_trouser_waist" model="tailoring.measurement.parameter">
        <field name="name">Trouser Waist</field>
        <field name="code">TR_WAIST</field>
        <field name="sequence">90</field>
        <field name="body_part">lower_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">24.0</field>
        <field name="max_allowed_value">65.0</field>
        <field name="help_instruction">Measure where the customer prefers to wear their trousers waistband.</field>
    </record>

    <record id="param_hips" model="tailoring.measurement.parameter">
        <field name="name">Hips / Seat Circumference</field>
        <field name="code">SEAT_HIPS</field>
        <field name="sequence">100</field>
        <field name="body_part">lower_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">28.0</field>
        <field name="max_allowed_value">70.0</field>
        <field name="help_instruction">Measure around the widest part of the buttocks / seat.</field>
    </record>

    <record id="param_outseam" model="tailoring.measurement.parameter">
        <field name="name">Trouser Outseam Length</field>
        <field name="code">OUTSEAM</field>
        <field name="sequence">110</field>
        <field name="body_part">leg</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">32.0</field>
        <field name="max_allowed_value">52.0</field>
        <field name="help_instruction">From top of waistband down the outside leg seam to shoe heel level.</field>
    </record>

    <record id="param_inseam" model="tailoring.measurement.parameter">
        <field name="name">Trouser Inseam Length</field>
        <field name="code">INSEAM</field>
        <field name="sequence">120</field>
        <field name="body_part">leg</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">24.0</field>
        <field name="max_allowed_value">42.0</field>
        <field name="help_instruction">From bottom of crotch seam down inner leg to bottom hem.</field>
    </record>

    <record id="param_thigh" model="tailoring.measurement.parameter">
        <field name="name">Thigh Circumference</field>
        <field name="code">THIGH</field>
        <field name="sequence">130</field>
        <field name="body_part">leg</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">16.0</field>
        <field name="max_allowed_value">36.0</field>
        <field name="help_instruction">Measure around the fullest part of the upper thigh.</field>
    </record>

    <record id="param_knee" model="tailoring.measurement.parameter">
        <field name="name">Knee Circumference</field>
        <field name="code">KNEE</field>
        <field name="sequence">140</field>
        <field name="body_part">leg</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">12.0</field>
        <field name="max_allowed_value">26.0</field>
        <field name="help_instruction">Measure around knee midpoint with leg straight.</field>
    </record>

    <record id="param_bottom_hem" model="tailoring.measurement.parameter">
        <field name="name">Trouser Bottom Leg Opening</field>
        <field name="code">BOT_HEM</field>
        <field name="sequence">150</field>
        <field name="body_part">leg</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">12.0</field>
        <field name="max_allowed_value">24.0</field>
        <field name="help_instruction">Desired total circumference of trouser leg opening.</field>
    </record>

    <record id="param_crotch_rise" model="tailoring.measurement.parameter">
        <field name="name">Total Crotch / Rise</field>
        <field name="code">CROTCH_RISE</field>
        <field name="sequence">160</field>
        <field name="body_part">lower_body</field>
        <field name="default_unit">inch</field>
        <field name="min_allowed_value">20.0</field>
        <field name="max_allowed_value">38.0</field>
        <field name="help_instruction">From front waistband down through crotch to back waistband.</field>
    </record>

    <!-- Style Options -->
    <record id="style_lapel" model="tailoring.style.option">
        <field name="name">Lapel Construction</field>
        <field name="code">LAPEL</field>
        <field name="sequence">10</field>
        <field name="category">lapel</field>
    </record>

    <record id="val_lapel_notch" model="tailoring.style.option.value">
        <field name="option_id" ref="style_lapel"/>
        <field name="name">Standard Notch Lapel (3.25")</field>
        <field name="code">NOTCH_STD</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
        <field name="description">Classic versatile business lapel</field>
    </record>

    <record id="val_lapel_peak" model="tailoring.style.option.value">
        <field name="option_id" ref="style_lapel"/>
