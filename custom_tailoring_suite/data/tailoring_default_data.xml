    <record id="style_closure" model="tailoring.style.option">
        <field name="name">Closure &amp; Button Stance</field>
        <field name="code">CLOSURE</field>
        <field name="sequence">20</field>
        <field name="category">buttons</field>
    </record>

    <record id="val_closure_sb2" model="tailoring.style.option.value">
        <field name="option_id" ref="style_closure"/>
        <field name="name">Single Breasted 2-Button</field>
        <field name="code">SB_2B</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_closure_sb1" model="tailoring.style.option.value">
        <field name="option_id" ref="style_closure"/>
        <field name="name">Single Breasted 1-Button (Tuxedo)</field>
        <field name="code">SB_1B</field>
        <field name="sequence">20</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_closure_db62" model="tailoring.style.option.value">
        <field name="option_id" ref="style_closure"/>
        <field name="name">Double Breasted 6x2 (Classic Sartorial)</field>
        <field name="code">DB_6X2</field>
        <field name="sequence">30</field>
        <field name="price_extra">50.0</field>
    </record>

    <record id="style_vents" model="tailoring.style.option">
        <field name="name">Jacket Back Vents</field>
        <field name="code">VENTS</field>
        <field name="sequence">30</field>
        <field name="category">vents</field>
    </record>

    <record id="val_vents_double" model="tailoring.style.option.value">
        <field name="option_id" ref="style_vents"/>
        <field name="name">Double Side Vents (British Style)</field>
        <field name="code">VENTS_DOUBLE</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_vents_center" model="tailoring.style.option.value">
        <field name="option_id" ref="style_vents"/>
        <field name="name">Single Center Vent (American Style)</field>
        <field name="code">VENTS_CENTER</field>
        <field name="sequence">20</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_vents_none" model="tailoring.style.option.value">
        <field name="option_id" ref="style_vents"/>
        <field name="name">No Vents (Italian / Formal Dinner)</field>
        <field name="code">VENTS_NONE</field>
        <field name="sequence">30</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="style_lining" model="tailoring.style.option">
        <field name="name">Interior Lining &amp; Canvas</field>
        <field name="code">LINING</field>
        <field name="sequence">40</field>
        <field name="category">lining</field>
    </record>

    <record id="val_lining_full" model="tailoring.style.option.value">
        <field name="option_id" ref="style_lining"/>
        <field name="name">Full Bemberg Silk Lining</field>
        <field name="code">LIN_FULL_BEMBERG</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_lining_half" model="tailoring.style.option.value">
        <field name="option_id" ref="style_lining"/>
        <field name="name">Half-Lined Soft Construction</field>
        <field name="code">LIN_HALF</field>
        <field name="sequence">20</field>
        <field name="price_extra">30.0</field>
    </record>

    <record id="val_lining_custom" model="tailoring.style.option.value">
        <field name="option_id" ref="style_lining"/>
        <field name="name">Custom Artwork / Jacquard Silk Lining</field>
        <field name="code">LIN_ARTWORK</field>
        <field name="sequence">30</field>
        <field name="price_extra">75.0</field>
    </record>

    <record id="style_trouser_pleats" model="tailoring.style.option">
        <field name="name">Trouser Front Pleats</field>
        <field name="code">TR_PLEATS</field>
        <field name="sequence">50</field>
        <field name="category">trouser_pleats</field>
    </record>

    <record id="val_pleats_flat" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_pleats"/>
        <field name="name">Flat Front (No Pleat - Modern Slim)</field>
        <field name="code">PLEAT_FLAT</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_pleats_single" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_pleats"/>
        <field name="name">Single Forward Pleat</field>
        <field name="code">PLEAT_SINGLE</field>
        <field name="sequence">20</field>
        <field name="price_extra">15.0</field>
    </record>

    <record id="val_pleats_double" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_pleats"/>
        <field name="name">Double Deep Pleats (High-Rise Sartorial)</field>
        <field name="code">PLEAT_DOUBLE</field>
        <field name="sequence">30</field>
        <field name="price_extra">25.0</field>
    </record>

    <record id="style_trouser_hem" model="tailoring.style.option">
        <field name="name">Trouser Leg Hem Finish</field>
        <field name="code">TR_HEM</field>
        <field name="sequence">60</field>
        <field name="category">trouser_pleats</field>
    </record>

    <record id="val_hem_plain" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_hem"/>
        <field name="name">Plain Hem (Slanted European Break)</field>
        <field name="code">HEM_PLAIN</field>
        <field name="sequence">10</field>
        <field name="price_extra">0.0</field>
    </record>

    <record id="val_hem_cuff175" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_hem"/>
        <field name="name">1.75 inch Cuffs / Turn-ups</field>
        <field name="code">HEM_CUFF_175</field>
        <field name="sequence">20</field>
        <field name="price_extra">15.0</field>
    </record>

    <record id="val_hem_cuff20" model="tailoring.style.option.value">
        <field name="option_id" ref="style_trouser_hem"/>
        <field name="name">2.0 inch Bold Sartorial Cuffs</field>
        <field name="code">HEM_CUFF_20</field>
        <field name="sequence">30</field>
        <field name="price_extra">15.0</field>
    </record>

    <!-- Master Garment Types -->
    <record id="garment_suit_2pc" model="tailoring.garment.type">
        <field name="name">2-Piece Bespoke Suit (Jacket &amp; Trousers)</field>
        <field name="code">SUIT_2PC</field>
        <field name="sequence">10</field>
        <field name="category">suit</field>
        <field name="default_lead_time_days">21</field>
        <field name="estimated_labor_hours">28.0</field>
        <field name="standard_fabric_meters">3.5</field>
        <field name="parameter_ids" eval="[(6, 0, [
            ref('param_chest'), ref('param_neck'), ref('param_shoulder'),
            ref('param_sleeve'), ref('param_bicep'), ref('param_wrist'),
            ref('param_jacket_length'), ref('param_waist_jacket'),
            ref('param_trouser_waist'), ref('param_hips'), ref('param_outseam'),
            ref('param_inseam'), ref('param_thigh'), ref('param_knee'),
            ref('param_bottom_hem'), ref('param_crotch_rise')
        ])]"/>
        <field name="style_option_ids" eval="[(6, 0, [
            ref('style_lapel'), ref('style_closure'), ref('style_vents'),
            ref('style_lining'), ref('style_trouser_pleats'), ref('style_trouser_hem')
        ])]"/>
        <field name="description">Bespoke 2-piece suit with full horsehair floating canvas and hand-finished pick stitching.</field>
    </record>

    <record id="garment_shirt_dress" model="tailoring.garment.type">
        <field name="name">Bespoke Custom Dress Shirt</field>
        <field name="code">SHIRT_DRESS</field>
        <field name="sequence">20</field>
        <field name="category">shirt</field>
        <field name="default_lead_time_days">10</field>
        <field name="estimated_labor_hours">6.0</field>
        <field name="standard_fabric_meters">2.0</field>
        <field name="parameter_ids" eval="[(6, 0, [
            ref('param_neck'), ref('param_chest'), ref('param_waist_jacket'),
            ref('param_shoulder'), ref('param_sleeve'), ref('param_bicep'), ref('param_wrist')
        ])]"/>
        <field name="description">Custom luxury dress shirt with mother-of-pearl buttons and split yoke.</field>
    </record>

    <record id="garment_trousers" model="tailoring.garment.type">
        <field name="name">Bespoke Tailored Trousers</field>
        <field name="code">TROUSERS</field>
        <field name="sequence">30</field>
        <field name="category">trouser</field>
        <field name="default_lead_time_days">12</field>
        <field name="estimated_labor_hours">8.0</field>
        <field name="standard_fabric_meters">1.6</field>
        <field name="parameter_ids" eval="[(6, 0, [
            ref('param_trouser_waist'), ref('param_hips'), ref('param_outseam'),
            ref('param_inseam'), ref('param_thigh'), ref('param_knee'),
            ref('param_bottom_hem'), ref('param_crotch_rise')
        ])]"/>
        <field name="style_option_ids" eval="[(6, 0, [
            ref('style_trouser_pleats'), ref('style_trouser_hem')
        ])]"/>
        <field name="description">Custom fitted trousers with side adjusters, curtain waistband and hand-basted cuffs.</field>
    </record>

    <record id="garment_tuxedo" model="tailoring.garment.type">
        <field name="name">Bespoke Black Tie Tuxedo / Dinner Suit</field>
        <field name="code">TUXEDO_DINNER</field>
        <field name="sequence">40</field>
        <field name="category">suit</field>
        <field name="default_lead_time_days">28</field>
        <field name="estimated_labor_hours">32.0</field>
        <field name="standard_fabric_meters">3.8</field>
        <field name="parameter_ids" eval="[(6, 0, [
            ref('param_chest'), ref('param_neck'), ref('param_shoulder'),
            ref('param_sleeve'), ref('param_bicep'), ref('param_wrist'),
            ref('param_jacket_length'), ref('param_waist_jacket'),
            ref('param_trouser_waist'), ref('param_hips'), ref('param_outseam'),
            ref('param_inseam'), ref('param_thigh'), ref('param_knee'),
            ref('param_bottom_hem'), ref('param_crotch_rise')
        ])]"/>
        <field name="style_option_ids" eval="[(6, 0, [
            ref('style_lapel'), ref('style_closure'), ref('style_vents'),
            ref('style_lining'), ref('style_trouser_pleats'), ref('style_trouser_hem')
        ])]"/>
        <field name="description">Bespoke tuxedo with silk grosgrain/satin facings, jetted pockets, and satin trouser galloon stripe.</field>
    </record>

</odoo>
