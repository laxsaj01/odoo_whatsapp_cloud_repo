<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_ai_ocr" model="ir.module.category">
            <field name="name">Smart AI Invoice OCR</field>
            <field name="description">User roles and permissions for AI Invoice &amp; Vendor Bill OCR Automation</field>
            <field name="sequence">30</field>
        </record>

        <!-- User / Accountant Group -->
        <record id="group_ai_ocr_user" model="res.groups">
            <field name="name">User / Accountant</field>
            <field name="category_id" ref="module_category_ai_ocr"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Accountants can upload invoices, run AI OCR scans, and review generated draft bills.</field>
        </record>

        <!-- Manager / Administrator Group -->
        <record id="group_ai_ocr_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_ai_ocr"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_ocr_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Administrators can configure OpenAI / Claude API keys, set default models, and manage system OCR queues.</field>
        </record>
    </data>

    <!-- Multi-Company Record Rules -->
    <data noupdate="1">
        <record id="ai_ocr_provider_company_rule" model="ir.rule">
            <field name="name">AI OCR Provider Multi-Company</field>
            <field name="model_id" ref="model_ai_ocr_provider"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="ai_ocr_queue_company_rule" model="ir.rule">
            <field name="name">AI OCR Queue Multi-Company</field>
            <field name="model_id" ref="model_ai_ocr_queue"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
