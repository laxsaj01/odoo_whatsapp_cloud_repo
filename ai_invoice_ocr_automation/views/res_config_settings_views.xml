<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ai_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Smart AI Invoice OCR" string="AI Invoice OCR" name="ai_invoice_ocr_automation">
                    <block title="AI Engine Configuration" name="ai_ocr_engine_settings">
                        <setting id="ai_ocr_provider_setting" string="Default AI OCR Provider" help="Select primary verified vision model (OpenAI / Claude / Gemini).">
                            <field name="ai_ocr_default_provider_id"/>
                        </setting>
                    </block>
                    <block title="Automation &amp; Validation Policies" name="ai_ocr_policy_settings">
                        <setting id="ai_ocr_partner_setting" string="Auto-Create New Vendors" help="Automatically create draft vendor contact if supplier details are not found in Odoo.">
                            <field name="ai_ocr_auto_create_partner"/>
                        </setting>
                        <setting id="ai_ocr_post_setting" string="Auto-Confirm High Confidence Bills" help="Automatically post bills with confidence score &gt; 95% (Recommended to leave unchecked for manual accountant approval).">
                            <field name="ai_ocr_auto_post_bill"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ai_ocr_config_settings" model="ir.actions.act_window">
        <field name="name">OCR Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ai_invoice_ocr_automation', 'bin_size': False}</field>
    </record>
</odoo>
